		{
			"name": "Public: Просмотр комментариев",
			"item": [
				{
					"name": "Получить список комментариев события",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Статус 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Ответ - массив\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an('array');",
									"});",
									"",
									"pm.test(\"Комментарии содержат нужные поля\", function () {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.length > 0) {",
									"        var comment = jsonData[0];",
									"        pm.expect(comment).to.have.property('id');",
									"        pm.expect(comment).to.have.property('text');",
									"        pm.expect(comment).to.have.property('userId');",
									"        pm.expect(comment).to.have.property('eventId');",
									"        pm.expect(comment).to.have.property('createdOn');",
									"    }",
									"});",
									"",
									"pm.test(\"Найден созданный комментарий\", function () {",
									"    var jsonData = pm.response.json();",
									"    var commentId = parseInt(pm.collectionVariables.get('commentId'));",
									"    var found = jsonData.some(c => c.id === commentId);",
									"    pm.expect(found).to.be.true;",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/events/{{eventId}}/comments",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"events",
								"{{eventId}}",
								"comments"
							]
						},
						"description": "GET /events/{eventId}/comments - получение списка комментариев"
					},
					"response": []
				},
				{
					"name": "Получить событие с комментариями",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Статус 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Событие содержит основные поля\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('id');",
									"    pm.expect(jsonData).to.have.property('title');",
									"    pm.expect(jsonData).to.have.property('annotation');",
									"});",
									"",
									"pm.test(\"Событие содержит список комментариев\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('comments');",
									"    pm.expect(jsonData.comments).to.be.an('array');",
									"});",
									"",
									"pm.test(\"Комментарии в легковесной DTO (текст + userId)\", function () {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.comments && jsonData.comments.length > 0) {",
									"        var comment = jsonData.comments[0];",
									"        pm.expect(comment).to.have.property('text');",
									"        pm.expect(comment).to.have.property('userId');",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
