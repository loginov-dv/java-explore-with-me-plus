		{
			"name": "Private: Комментарии",
			"item": [
				{
					"name": "Создать комментарий",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Статус 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Комментарий содержит все поля модели\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('id');",
									"    pm.expect(jsonData).to.have.property('text');",
									"    pm.expect(jsonData).to.have.property('userId');",
									"    pm.expect(jsonData).to.have.property('eventId');",
									"    pm.expect(jsonData).to.have.property('createdOn');",
									"    /*pm.expect(jsonData).to.have.property('edited');*/",
									"    pm.expect(jsonData).to.have.property('editedOn');",
									"});",
									"",
									"pm.test(\"Комментарий не помечен как отредактированный\", function () {",
									"    var jsonData = pm.response.json();",
									"    /*pm.expect(jsonData.edited).to.eql(false);*/",
									"    pm.expect(jsonData.editedOn).to.be.null;",
									"});",
									"",
									"pm.test(\"Текст комментария совпадает\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.text).to.include('Отличное событие');",
									"});",
									"",
									"pm.test(\"userId и eventId корректны\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.userId).to.eql(parseInt(pm.collectionVariables.get('userId')));",
									"    pm.expect(jsonData.eventId).to.eql(parseInt(pm.collectionVariables.get('eventId')));",
									"});",
									"",
									"pm.test(\"Дата создания в правильном формате\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.createdOn).to.match(/^\\d{4}-\\d{2}-\\d{2}\\s{1}\\d{2}:\\d{2}:\\d{2}$/);",
									"});",
									"",
									"// Сохраняем ID для последующих тестов",
									"var jsonData = pm.response.json();",
									"pm.collectionVariables.set('commentId', jsonData.id);"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
