				{
					"name": "Редактировать комментарий",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Статус 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Текст обновлен\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.text).to.include('ОБНОВЛЕНО');",
									"});",
									"",
									"/*pm.test(\"Флаг edited установлен в true\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.edited).to.eql(true);",
									"});*/",
									"",
									"pm.test(\"Поле editedOn заполнено\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.editedOn).to.not.be.null;",
									"    pm.expect(jsonData.editedOn).to.match(/^\\d{4}-\\d{2}-\\d{2}\\s{1}\\d{2}:\\d{2}:\\d{2}$/);",
									"});",
									"",
									"pm.test(\"editedOn позже createdOn\", function () {",
									"    var jsonData = pm.response.json();",
									"    var created = new Date(jsonData.createdOn);",
									"    var edited = new Date(jsonData.editedOn);",
									"    pm.expect(edited.getTime()).to.be.above(created.getTime());",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
